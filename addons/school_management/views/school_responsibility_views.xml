<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Branch / Campus ============ -->

    <record id="view_school_campus_tree" model="ir.ui.view">
        <field name="name">school.campus.tree</field>
        <field name="model">school.campus</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_school_campus_form" model="ir.ui.view">
        <field name="name">school.campus.form</field>
        <field name="model">school.campus</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="address" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_campus_search" model="ir.ui.view">
        <field name="name">school.campus.search</field>
        <field name="model">school.campus</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_school_campus" model="ir.actions.act_window">
        <field name="name">Branches / Campuses</field>
        <field name="res_model">school.campus</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Staff responsibilities ============ -->

    <record id="view_school_staff_responsibility_tree" model="ir.ui.view">
        <field name="name">school.staff.responsibility.tree</field>
        <field name="model">school.staff.responsibility</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-bf="is_primary == True">
                <field name="staff_id"/>
                <field name="responsibility"/>
                <field name="is_primary"/>
                <field name="department"/>
                <field name="campus_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="view_school_staff_responsibility_form" model="ir.ui.view">
        <field name="name">school.staff.responsibility.form</field>
        <field name="model">school.staff.responsibility</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Assignment">
                            <field name="staff_id"/>
                            <field name="responsibility"/>
                            <field name="is_primary"/>
                        </group>
                        <group string="Context">
                            <field name="department"/>
                            <field name="campus_id"/>
                        </group>
                        <group string="Effective Period">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_staff_responsibility_search" model="ir.ui.view">
        <field name="name">school.staff.responsibility.search</field>
        <field name="model">school.staff.responsibility</field>
        <field name="arch" type="xml">
            <search>
                <field name="staff_id"/>
                <field name="campus_id"/>
                <filter string="Primary" name="primary" domain="[('is_primary', '=', True)]"/>
                <filter string="Current" name="current"
                        domain="['|', ('end_date', '=', False), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Responsibility" name="group_resp" context="{'group_by': 'responsibility'}"/>
                    <filter string="Department" name="group_dept" context="{'group_by': 'department'}"/>
                    <filter string="Branch / Campus" name="group_campus" context="{'group_by': 'campus_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_staff_responsibility" model="ir.actions.act_window">
        <field name="name">Responsibilities</field>
        <field name="res_model">school.staff.responsibility</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign a responsibility such as Registrar, Department Head, or Librarian.
            </p>
        </field>
    </record>

    <!-- ============ Staff form: responsibilities, control status, smart buttons ============ -->

    <record id="view_school_staff_form_responsibility" model="ir.ui.view">
        <field name="name">school.staff.form.responsibility</field>
        <field name="model">school.staff</field>
        <field name="inherit_id" ref="view_school_staff_form"/>
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_suspend" string="Suspend" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_deactivate" string="Deactivate" type="object"
                            invisible="state in ['draft', 'inactive', 'archived']"
                            confirm="This also deactivates the linked Odoo login. Continue?"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,suspended,inactive"/>
                </header>
            </sheet>
            <sheet position="inside">
                <div name="button_box" class="oe_button_box">
                    <button name="action_open_responsibilities" type="object"
                            class="oe_stat_button" icon="fa-sitemap">
                        <field name="responsibility_count" widget="statinfo" string="Responsibilities"/>
                    </button>
                </div>
            </sheet>
            <notebook position="inside">
                <page string="Responsibility" name="responsibility">
                    <group>
                        <group>
                            <field name="primary_responsibility" readonly="1"/>
                        </group>
                    </group>
                    <field name="responsibility_ids">
                        <list editable="bottom">
                            <field name="responsibility"/>
                            <field name="is_primary"/>
                            <field name="department"/>
                            <field name="campus_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_school_staff_tree_state" model="ir.ui.view">
        <field name="name">school.staff.tree.state</field>
        <field name="model">school.staff</field>
        <field name="inherit_id" ref="view_school_staff_tree"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="primary_responsibility" optional="show"/>
                <field name="campus_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'suspended'"
                       decoration-muted="state in ['inactive', 'archived']"/>
            </list>
        </field>
    </record>
</odoo>
