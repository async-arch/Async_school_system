<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Teacher Tree View -->
    <record id="view_school_teacher_tree" model="ir.ui.view">
        <field name="name">school.teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="teacher_id"/>
                <field name="name"/>
                <field name="department"/>
                <field name="primary_responsibility"/>
                <field name="qualification"/>
                <field name="specialization"/>
                <field name="teaching_status"
                       decoration-success="teaching_status == 'active'"
                       decoration-danger="teaching_status == 'inactive'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Primary Editable Teacher Form (Priority 1 ensures it's the default registration form) -->
    <record id="view_school_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_login_user" type="object" string="Create Login" class="oe_highlight" invisible="user_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="teacher_id" readonly="1"/>
                            <field name="name"/>
                            <field name="staff_id"/>
                            <field name="department" readonly="1"/>
                            <field name="primary_responsibility" readonly="1"/>
                            <field name="teaching_status"/>
                            <field name="user_id" string="Login User"/>
                            <!-- widget="password", not password="True": the legacy
                                 attribute only masks the input, while the widget adds
                                 the reveal toggle needed to check a typed password. -->
                            <field name="login_password" widget="password"
                                   placeholder="8+ chars, upper, lower, number, symbol"/>
                        </group>
                        <group>
                            <field name="qualification"/>
                            <field name="specialization"/>
                            <field name="years_of_experience"/>
                            <field name="hire_date"/>
                            <field name="available_days"/>
                            <field name="max_weekly_workload"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assignments">
                            <!-- Same domains as the standalone Teacher Assignments form:
                                 assignments created from here used to offer every subject
                                 and every term, so a curriculum or academic-year mismatch
                                 only surfaced as an error after saving. -->
                            <field name="assignment_ids">
                                <list editable="bottom">
                                    <field name="class_id"/>
                                    <field name="academic_year_id" readonly="1" optional="show"/>
                                    <field name="subject_id"
                                           domain="[('grade_subject_ids.class_id', '=', class_id), ('active', '=', True)]"
                                           options="{'no_create': True}"/>
                                    <field name="term_id"
                                           domain="[('academic_year_id', '=', academic_year_id), ('active', '=', True)]"
                                           options="{'no_create': True}"/>
                                    <field name="responsibility"/>
                                    <field name="weekly_periods"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_teacher_search" model="ir.ui.view">
        <field name="name">school.teacher.search</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="staff_id"/>
                <field name="qualification"/>
                <field name="specialization"/>
                <field name="department"/>
                <separator/>
                <filter name="filter_active" string="Active Teachers"
                        domain="[('teaching_status', '=', 'active')]"/>
                <filter name="filter_inactive" string="Inactive Teachers"
                        domain="[('teaching_status', '=', 'inactive')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department'}"/>
                    <filter name="group_teaching_status" string="Teaching Status"
                            context="{'group_by': 'teaching_status'}"/>
                    <filter name="group_primary_responsibility" string="Primary Responsibility"
                            context="{'group_by': 'primary_responsibility'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Teachers Window Action (Explicitly mapped to tree and primary form views) -->
    <record id="action_school_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_school_teacher_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_school_teacher_form')})
        ]"/>
        <field name="search_view_id" ref="view_school_teacher_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No teacher profiles yet
            </p>
            <p>
                First open <strong>Registrar → Staff</strong>. Create or open the
                staff member, set the Department to <strong>Academic</strong>, add a
                primary <strong>Teacher</strong> responsibility, then click
                <strong>Activate</strong>. Return here and click New.
            </p>
        </field>
    </record>

    <!-- Server Action for Teacher Dashboard -->
    <record id="action_server_open_my_dashboard" model="ir.actions.server">
        <field name="name">My Dashboard</field>
        <field name="model_id" ref="model_school_teacher"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_my_dashboard()
        </field>
    </record>

</odoo>
