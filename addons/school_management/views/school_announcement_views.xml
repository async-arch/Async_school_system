<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_announcement_tree" model="ir.ui.view">
        <field name="name">school.announcement.tree</field>
        <field name="model">school.announcement</field>
        <field name="arch" type="xml">
            <list decoration-bf="priority == '2'" decoration-muted="state == 'archived'">
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="category"/>
                <field name="audience_type"/>
                <field name="publish_datetime"/>
                <field name="expiry_datetime" optional="show"/>
                <field name="author_id" optional="show"/>
                <field name="is_live" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_school_announcement_kanban" model="ir.ui.view">
        <field name="name">school.announcement.kanban</field>
        <field name="model">school.announcement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category" class="o_kanban_small_column">
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge rounded-pill text-bg-danger" invisible="priority != '2'">
                                    Urgent
                                </span>
                                <span class="badge rounded-pill text-bg-warning" invisible="priority != '1'">
                                    Important
                                </span>
                                <div><field name="audience_type"/></div>
                                <div class="text-muted"><field name="publish_datetime"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'draft': 'default', 'published': 'success', 'archived': 'secondary'}}"/>
                                <div class="oe_kanban_bottom_right">
                                    <field name="author_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_school_announcement_form" model="ir.ui.view">
        <field name="name">school.announcement.form</field>
        <field name="model">school.announcement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_archive_announcement" string="Archive" type="object"
                            invisible="state != 'published'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="priority != '2'">
                        Urgent announcement.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Term 1 Examination Timetable"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                            <field name="author_id"/>
                        </group>
                        <group string="Publication">
                            <field name="publish_datetime"/>
                            <field name="expiry_datetime"/>
                            <field name="is_live"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Audience">
                        <field name="audience_type"/>
                        <field name="department" invisible="audience_type != 'department'"
                               required="audience_type == 'department'"/>
                        <field name="responsibility" invisible="audience_type != 'responsibility'"
                               required="audience_type == 'responsibility'"/>
                        <field name="teacher_ids" widget="many2many_tags"
                               invisible="audience_type != 'teacher_group'"
                               required="audience_type == 'teacher_group'"/>
                        <field name="subject_ids" widget="many2many_tags"
                               invisible="audience_type != 'subject_group'"
                               required="audience_type == 'subject_group'"/>
                        <field name="class_ids" widget="many2many_tags"
                               invisible="audience_type != 'class_section'"
                               required="audience_type == 'class_section'"/>
                        <field name="staff_ids" widget="many2many_tags"
                               invisible="audience_type != 'selected_staff'"
                               required="audience_type == 'selected_staff'"/>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="message" placeholder="What do staff need to know?"/>
                        </page>
                        <page string="Attachments and Links">
                            <group>
                                <field name="link" widget="url"/>
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                        <page string="Related Schedule">
                            <group>
                                <field name="program_id"/>
                                <field name="class_schedule_id"/>
                            </group>
                            <p class="text-muted">
                                Link a schedule-change announcement to the program or class period it affects.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_announcement_search" model="ir.ui.view">
        <field name="name">school.announcement.search</field>
        <field name="model">school.announcement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author_id"/>
                <filter string="Live" name="live" domain="[('is_live', '=', True)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Archived Publication" name="archived_state" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', '2')]"/>
                <filter string="Important or Urgent" name="important" domain="[('priority', '!=', '0')]"/>
                <separator/>
                <filter string="Expired" name="expired"
                        domain="[('expiry_datetime', '!=', False), ('expiry_datetime', '&lt;=', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Audience" name="group_audience" context="{'group_by': 'audience_type'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Publication" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">school.announcement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Publish an announcement to a targeted staff audience.
            </p>
        </field>
    </record>

    <record id="action_school_announcement_feed" model="ir.actions.act_window">
        <field name="name">My Announcements</field>
        <field name="res_model">school.announcement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_live', '=', True)]</field>
        <field name="context">{'search_default_group_priority': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing addressed to you right now.
            </p>
        </field>
    </record>
</odoo>
