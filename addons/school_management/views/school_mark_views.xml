<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_school_mark_tree" model="ir.ui.view">
        <field name="name">school.mark.tree</field>
        <field name="model">school.mark</field>
        <field name="arch" type="xml">
            <list create="0" delete="0"
                  decoration-danger="grade == 'F'" 
                  decoration-success="grade == 'A'"
                  decoration-muted="mark_status in ('pending', 'exempt', 'not_enrolled')">
                <field name="assessment_id" readonly="1"/>
                <field name="student_id" readonly="1"/>
                <field name="class_id" readonly="1" optional="show"/>
                <field name="subject_id" readonly="1"/>
                <field name="term_id" readonly="1" optional="hide"/>
                <field name="exam_type" readonly="1" optional="hide"/>
                <field name="mark_status"/>
                <field name="score"/>
                <field name="max_score" readonly="1"/>
                <field name="percentage" readonly="1" optional="show"/>
                <field name="weight" readonly="1" optional="show"/>
                <field name="weighted_score" readonly="1" optional="show"/>
                <field name="grade" readonly="1"/>
                <field name="academic_year_id" readonly="1" optional="hide"/>
                <field name="recorded_by_id" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_school_mark_form" model="ir.ui.view">
        <field name="name">school.mark.form</field>
        <field name="model">school.mark</field>
        <field name="arch" type="xml">
            <form string="Student Mark" create="0" delete="0">
                <sheet>
                    <group>
                        <group string="Student Information">
                            <field name="student_id" readonly="1"/>
                            <field name="student_subject_id" readonly="1" options="{'no_create': True}"/>
                            <field name="class_id" readonly="1"/>
                            <field name="academic_year_id" readonly="1"/>
                        </group>
                        <group string="Assessment Details">
                            <field name="assessment_id" readonly="1"/>
                            <field name="subject_id" readonly="1"/>
                            <field name="term_id" readonly="1"/>
                            <field name="exam_type" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Result &amp; Grading">
                            <field name="mark_status"/>
                            <field name="score"/>
                            <field name="max_score" readonly="1"/>
                            <field name="percentage" readonly="1"/>
                            <field name="weight" readonly="1"/>
                            <field name="weighted_score" readonly="1"/>
                            <field name="grade" readonly="1"/>
                        </group>
                        <group string="Audit &amp; System Info">
                            <field name="recorded_by_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Remarks / Feedback">
                        <field name="note" nolabel="1" placeholder="Provide feedback for the student or guardian..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_school_mark_search" model="ir.ui.view">
        <field name="name">school.mark.search</field>
        <field name="model">school.mark</field>
        <field name="arch" type="xml">
            <search string="Search Marks">
                <field name="student_id"/>
                <field name="assessment_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="academic_year_id"/>
                <separator/>
                <filter string="Pending Recording" name="pending_marks" domain="[('mark_status', '=', 'pending')]"/>
                <filter string="Recorded Marks" name="recorded_marks" domain="[('mark_status', '=', 'recorded')]"/>
                <separator/>
                <filter string="Failing (&lt; 50%)" name="failing" domain="[('percentage', '&lt;', 50), ('mark_status', 'in', ('recorded', 'transfer'))]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Assessment" name="group_assessment" context="{'group_by': 'assessment_id'}"/>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Student" name="group_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Term" name="group_term" context="{'group_by': 'term_id'}"/>
                    <filter string="Grade" name="group_grade" context="{'group_by': 'grade'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'mark_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_school_mark" model="ir.actions.act_window">
        <field name="name">Mark List</field>
        <field name="res_model">school.mark</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_mark_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No marks recorded yet!
            </p>
            <p>
                Select an assessment to view, edit, and record marks for your assigned classes.
            </p>
        </field>
    </record>

</odoo>
