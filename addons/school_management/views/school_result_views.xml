<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_grading_policy_tree" model="ir.ui.view">
        <field name="name">school.grading.policy.tree</field>
        <field name="model">school.grading.policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="pass_percentage"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_school_grading_policy_form" model="ir.ui.view">
        <field name="name">school.grading.policy.form</field>
        <field name="model">school.grading.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="pass_percentage"/>
                        <field name="active"/>
                    </group>
                    <field name="band_ids">
                        <tree editable="bottom">
                            <field name="sequence"/>
                            <field name="minimum_percentage"/>
                            <field name="letter_grade"/>
                            <field name="label"/>
                            <field name="active"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_school_subject_result_tree" model="ir.ui.view">
        <field name="name">school.subject.result.tree</field>
        <field name="model">school.subject.result</field>
        <field name="arch" type="xml">
            <tree>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="term_id"/>
                <field name="percentage"/>
                <field name="grade"/>
                <field name="result_status" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="action_school_grading_policy" model="ir.actions.act_window">
        <field name="name">Grading Policies</field>
        <field name="res_model">school.grading.policy</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_school_subject_result" model="ir.actions.act_window">
        <field name="name">Subject Results</field>
        <field name="res_model">school.subject.result</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
