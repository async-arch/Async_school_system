<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboards are native graph and pivot views over the real records. Record
         rules already scope every one of them, so the same action shows a teacher
         their own classes and an Academic Director the whole school. -->

    <record id="view_school_mark_graph" model="ir.ui.view">
        <field name="name">school.mark.graph</field>
        <field name="model">school.mark</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="subject_id"/>
                <field name="term_id"/>
                <field name="percentage" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_school_mark_pivot" model="ir.ui.view">
        <field name="name">school.mark.pivot</field>
        <field name="model">school.mark</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="class_id" type="row"/>
                <field name="subject_id" type="row"/>
                <field name="term_id" type="col"/>
                <field name="percentage" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_school_attendance_graph" model="ir.ui.view">
        <field name="name">school.attendance.graph</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" sample="1">
                <field name="class_id"/>
                <field name="status"/>
            </graph>
        </field>
    </record>

    <record id="view_school_attendance_pivot" model="ir.ui.view">
        <field name="name">school.attendance.pivot</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="class_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_school_teacher_assignment_graph" model="ir.ui.view">
        <field name="name">school.teacher.assignment.graph</field>
        <field name="model">school.teacher.assignment</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="teacher_id"/>
                <field name="weekly_periods" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_school_class_schedule_graph" model="ir.ui.view">
        <field name="name">school.class.schedule.graph</field>
        <field name="model">school.class.schedule</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" sample="1">
                <field name="teacher_id"/>
                <field name="day_of_week"/>
            </graph>
        </field>
    </record>

    <!-- ============ Role dashboards ============ -->

    <record id="action_school_dashboard_results" model="ir.actions.act_window">
        <field name="name">Results Analysis</field>
        <field name="res_model">school.mark</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_group_subject': 1}</field>
    </record>

    <record id="action_school_dashboard_attendance" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>

    <record id="action_school_dashboard_workload" model="ir.actions.act_window">
        <field name="name">Teacher Workload</field>
        <field name="res_model">school.teacher.assignment</field>
        <field name="view_mode">graph,pivot,list,form</field>
    </record>

    <record id="action_school_dashboard_schedule_load" model="ir.actions.act_window">
        <field name="name">Schedule Coverage</field>
        <field name="res_model">school.class.schedule</field>
        <field name="view_mode">graph,list,calendar,form</field>
        <field name="context">{'search_default_published': 1}</field>
    </record>

    <record id="action_school_my_timetable" model="ir.actions.act_window">
        <field name="name">My Timetable</field>
        <field name="res_model">school.class.schedule</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_group_day': 1, 'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No class periods are assigned to you yet.
            </p>
        </field>
    </record>

    <record id="action_school_my_attendance_tasks" model="ir.actions.act_window">
        <field name="name">Attendance Entry</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1, 'search_default_group_class': 1}</field>
    </record>

    <record id="action_school_my_mark_tasks" model="ir.actions.act_window">
        <field name="name">Mark Entry</field>
        <field name="res_model">school.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_class': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an assessment to enter marks.
            </p>
            <p>
                Choose the class, subject, term, and exact teacher assignment,
                then use Open &amp; Generate List to load the eligible students.
            </p>
        </field>
    </record>
</odoo>
