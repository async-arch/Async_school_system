<odoo>
    <record id="view_school_class_tree" model="ir.ui.view">
        <field name="name">school.class.tree</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="section_id"/>
                <field name="academic_year_id"/>
                <field name="education_level"/>
                <field name="min_age"/>
                <field name="max_age"/>
                <field name="is_entry_level"/>
            </list>
        </field>
    </record>

    <record id="view_school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="section_id" options="{'no_create': True}"/>
                            <field name="name" placeholder="Filled from Grade and Section"/>
                            <field name="academic_year_id" options="{'no_create': True}"/>
                            <field name="education_level"/>
                        </group>
                        <group>
                            <field name="is_entry_level"/>
                            <field name="min_age"/>
                            <field name="max_age"/>
                            <field name="capacity"/>
                        </group>
                    </group>
                    <field name="student_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>