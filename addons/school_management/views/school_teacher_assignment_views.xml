<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_teacher_assignment_tree" model="ir.ui.view">
        <field name="name">school.teacher.assignment.tree</field>
        <field name="model">school.teacher.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="academic_year_id"/>
                <field name="term_id"/>
                <field name="responsibility"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_school_teacher_assignment_form" model="ir.ui.view">
        <field name="name">school.teacher.assignment.form</field>
        <field name="model">school.teacher.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="class_id"/>
                            <field name="academic_year_id"/>
                            <field name="subject_id" domain="[('grade_subject_ids.class_id', '=', class_id), ('active', '=', True)]" options="{'no_create': True}"/>
                            <field name="term_id" domain="[('academic_year_id', '=', academic_year_id), ('active', '=', True)]" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="teacher_id"
                                   context="{'assignment_academic_year': academic_year_id, 'assignment_term': term_id}"/>
                            <field name="responsibility"/>
                            <field name="weekly_periods"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_teacher_assignment_search" model="ir.ui.view">
        <field name="name">school.teacher.assignment.search</field>
        <field name="model">school.teacher.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Term" name="group_term" context="{'group_by': 'term_id'}"/>
                    <filter string="Responsibility" name="group_responsibility" context="{'group_by': 'responsibility'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_assignment" model="ir.actions.act_window">
        <field name="name">Teacher Assignments</field>
        <field name="res_model">school.teacher.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
