<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_school_student_tree" model="ir.ui.view">
        <field name="name">school.student.tree</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list decoration-info="registration_status == 'draft'"
                  decoration-warning="registration_status == 'submitted'"
                  decoration-success="registration_status == 'approved'"
                  decoration-danger="registration_status == 'rejected'">
                <field name="regno"/>
                <field name="name"/>
                <field name="education_level" optional="show"/>
                <field name="class_id"/>
                <field name="guardian_name"/>
                <field name="guardian_phone"/>
                <field name="registration_status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Student Registration">
                <header>
                    <button name="action_mark_submitted" type="object" string="Submit Registration"
                            class="oe_highlight" invisible="registration_status not in ('draft', 'incomplete')"/>
                    <button name="action_mark_approved" type="object" string="Approve"
                            class="oe_highlight" invisible="registration_status != 'submitted'"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                    <field name="registration_status" widget="statusbar" statusbar_visible="draft,submitted,approved,incomplete,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_enrollments" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="regno" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Student Full Name" readonly="registration_status == 'approved'"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Identity &amp; Academic Placement">
                            <field name="date_of_birth" readonly="registration_status == 'approved'"/>
                            <field name="age" readonly="1"/>
                            <field name="gender" readonly="registration_status == 'approved'"/>
                            <field name="nationality_id" options="{'no_create': True}" readonly="registration_status == 'approved'"/>
                            <field name="education_level" readonly="registration_status == 'approved'"/>
                            <field name="admission_type" readonly="registration_status == 'approved'"/>
                            <field name="academic_year_id" options="{'no_create': True}" readonly="registration_status == 'approved'"/>
                            <field name="class_id" domain="[('academic_year_id', '=', academic_year_id), '|', ('education_level', '=', False), ('education_level', '=', education_level)]" options="{'no_create': True, 'no_create_edit': True}" readonly="registration_status == 'approved'"/>
                            <field name="section_id" readonly="1"/>
                            <field name="class_grade_level" invisible="1"/>
                            <field name="stream_id" invisible="class_grade_level not in ('11', '12')" required="class_grade_level in ('11', '12')" readonly="registration_status == 'approved'"/>
                        </group>
                        <group string="Intake Parent / Guardian">
                            <field name="guardian_name" readonly="registration_status == 'approved'"/>
                            <field name="guardian_phone" placeholder="e.g. 912345678" readonly="registration_status == 'approved'"/>
                            <field name="previous_school" readonly="registration_status == 'approved'"/>
                            <field name="address" readonly="registration_status == 'approved'"/>
                        </group>
                    </group>

                    <group string="Emergency Contact">
                        <group>
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone" placeholder="e.g. 912345678"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Required Documents" name="documents">
                            <group>
                                <group string="Birth Certificate">
                                    <field name="birth_certificate" filename="birth_certificate_filename"/>
                                    <field name="birth_certificate_filename" invisible="1"/>
                                </group>
                                <group string="Prior Academic Records">
                                    <field name="previous_grade_document" filename="previous_grade_document_filename"/>
                                    <field name="previous_grade_document_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Linked Guardians" name="guardians" invisible="registration_status != 'approved'">
                            <field name="guardian_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="is_primary"/>
                                </list>
                            </field>
                        </page>

                        <page string="Registration Metadata" name="metadata">
                            <group>
                                <group>
                                    <field name="registration_date" readonly="1"/>
                                    <field name="responsible_staff_id" readonly="1"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="notes" nolabel="1" placeholder="Internal registration comments..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_school_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search string="Search Students">
                <field name="name" string="Student Name or Registration #" filter_domain="['|', ('name', 'ilike', self), ('regno', 'ilike', self)]"/>
                <field name="guardian_name"/>
                <field name="class_id"/>
                <field name="education_level"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('registration_status', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('registration_status', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('registration_status', '=', 'approved')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Status" name="group_status" context="{'group_by': 'registration_status'}"/>
                    <filter string="Education Level" name="group_education_level" context="{'group_by': 'education_level'}"/>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_student_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new student!
            </p>
            <p>
                Enter student details, attach birth certificate and previous grade documents, and submit for approval.
            </p>
        </field>
    </record>

</odoo>
