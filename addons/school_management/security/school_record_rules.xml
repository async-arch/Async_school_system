        <field name="model_id" ref="model_school_assessment"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_assessment_own_class_subject_teacher" model="ir.rule">
        <field name="name">Assessments: own class and subject only — Teacher</field>
        <field name="model_id" ref="model_school_assessment"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">user._school_teacher_pair_domain()</field>
