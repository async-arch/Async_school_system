    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  ANNOUNCEMENTS                                                         -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <record id="rule_announcement_all_registrar" model="ir.rule">
        <field name="name">Announcements: own as author or targeted at me — Registrar</field>
        <field name="model_id" ref="model_school_announcement"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">['|', ('author_id', '=', user.id), '&amp;', ('visibility_active', '=', True), ('recipient_user_ids', 'in', user.id)]</field>
    </record>

    <record id="rule_announcement_own_frontoffice" model="ir.rule">
        <field name="name">Announcements: own as author or targeted at me — Front Office</field>
        <field name="model_id" ref="model_school_announcement"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_frontoffice'))]"/>
        <field name="domain_force">['|', ('author_id', '=', user.id), '&amp;', ('visibility_active', '=', True), ('recipient_user_ids', 'in', user.id)]</field>
    </record>

    <record id="rule_announcement_published_teacher" model="ir.rule">
        <field name="name">Announcements: published and targeted at me — Teacher</field>
        <field name="model_id" ref="model_school_announcement"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">['&amp;', ('visibility_active', '=', True), ('recipient_user_ids', 'in', user.id)]</field>
    </record>

    <record id="rule_announcement_all_director" model="ir.rule">
        <field name="name">Announcements: all records — Director</field>
        <field name="model_id" ref="model_school_announcement"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
