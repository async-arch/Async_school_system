        <field name="model_id" ref="model_school_program"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">['|',
            ('teacher_ids', 'in', user.school_teacher_id.ids),
            '&amp;', ('state', '!=', 'draft'), ('audience_type', '=', 'all_staff')
