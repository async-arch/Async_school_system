    <record id="rule_teacher_profile_write_own" model="ir.rule">
        <field name="name">Teacher profile: write own record only — Teacher</field>
        <field name="model_id" ref="model_school_teacher"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>