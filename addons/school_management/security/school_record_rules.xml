<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        School Management — Record Rules (Row-Level Access)
        ====================================================
        Odoo ORs all rules a user qualifies for.
        Each role gets its own narrow rule; Admin inherits all via implied_ids
        and automatically passes every rule through.

        Rule naming: <model>: <what the rule allows> for <role>
    -->

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  STAFF                                                                 -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <record id="rule_staff_all_registrar" model="ir.rule">
        <field name="name">Staff: all records — Registrar</field>
        <field name="model_id" ref="model_school_staff"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_staff_own_frontoffice" model="ir.rule">
        <field name="name">Staff: own record only — Front Office</field>
        <field name="model_id" ref="model_school_staff"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_frontoffice'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_staff_all_director" model="ir.rule">
        <field name="name">Staff: all records — Director</field>
        <field name="model_id" ref="model_school_staff"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  TEACHER PROFILE                                                       -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <record id="rule_school_teacher_read_own" model="ir.rule">
        <field name="name">Teachers: Read Own Profile</field>
        <field name="model_id" ref="model_school_teacher"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="perm_read" eval="True"/>
    </record>

    <record id="rule_school_teacher_read_all_management" model="ir.rule">
        <field name="name">Teachers: Read All Profiles for Management</field>
        <field name="model_id" ref="model_school_teacher"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar')), (4, ref('school_management.group_school_director')), (4, ref('school_management.group_school_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  STUDENTS                                                              -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <record id="rule_student_all_registrar" model="ir.rule">
        <field name="name">Students: all records — Registrar</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_student_all_director" model="ir.rule">
        <field name="name">Students: all records — Director</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_student_own_classes_teacher" model="ir.rule">
        <field name="name">Students: own classes only — Teacher</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">[('class_id', 'in', user.school_taught_class_ids.ids)]</field>
    </record>

    <record id="rule_student_contact_frontoffice" model="ir.rule">
        <field name="name">Students: all rows (contact lookup) — Front Office</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_frontoffice'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

