    <record id="rule_mark_all_director" model="ir.rule">
        <field name="name">Marks: all records — Director</field>
        <field name="model_id" ref="model_school_mark"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_mark_own_class_subject_teacher" model="ir.rule">
        <field name="name">Marks: own class and subject only — Teacher</field>
        <field name="model_id" ref="model_school_mark"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">user._school_teacher_pair_domain()</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  ASSESSMENTS                                                           -->
