        <field name="model_id" ref="model_school_student_guardian"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">[('student_id.class_id', 'in', user.school_taught_class_ids.ids)]</field>
    </record>

    <record id="rule_guardian_contact_frontoffice" model="ir.rule">
        <field name="name">Guardians: all rows (contact lookup) — Front Office</field>
        <field name="model_id" ref="model_school_student_guardian"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_frontoffice'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
