<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        School Management — Security Groups
        ====================================
        Six flat peer groups, one per operational role.
        No implicit hierarchy between peers.
        group_school_admin uses implied_ids to inherit all five others,
        so the technical administrator always has full access.
    -->

    <record id="module_category_school" model="ir.module.category">
        <field name="name">School Management</field>
        <field name="description">Role-based access for Ethiopian school staff.</field>
        <field name="sequence">20</field>
    </record>

    <!-- ── 1. System Administrator ─────────────────────────────────────────── -->
    <!-- Full access: user/access mgmt, Telegram bot config, system backups.   -->
    <!-- Defined first so implied_ids below can reference the other groups.     -->

    <!-- ── 2. Director / Principal ─────────────────────────────────────────── -->
    <!-- Approve enrollment & final results, school-wide dashboards,            -->
    <!-- promotion decisions. Read-only on daily operations.                   -->
    <record id="group_school_director" model="res.groups">
        <field name="name">Director / Principal</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="comment">Approve enrollment, approve results, view dashboards, make promotion decisions.</field>
    </record>

    <!-- ── 3. Registrar / Academic Officer ─────────────────────────────────── -->
    <!-- Student records, class assignment, academic year, exam scheduling,     -->
    <!-- transcripts, re-registration. No fee or payment access.               -->
    <record id="group_school_registrar" model="res.groups">
        <field name="name">Registrar / Academic Officer</field>
        <field name="category_id" ref="module_category_school"/>
        <!-- Contact creation: guardians are res.partner records the registrar
             creates during registration and approval. -->
        <field name="implied_ids" eval="[(4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Student records, class assignment, exam scheduling, transcripts, re-registration.</field>
    </record>

    <!-- ── 4. Teacher ──────────────────────────────────────────────────────── -->
    <!-- Attendance and marks for own assigned classes only (record-rule        -->
    <!-- restricted). No financial or administrative access.                   -->
    <record id="group_school_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="comment">Attendance and grade entry for own assigned classes only.</field>
    </record>

    <!-- ── 5. Finance Officer / Cashier ────────────────────────────────────── -->
    <!-- Invoices, payments (cash/Telebirr/bank/CBE Birr), fee confirmation     -->
    <!-- that unlocks enrollment. No access to grades or attendance.           -->
    <record id="group_school_finance" model="res.groups">
        <field name="name">Finance Officer</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="comment">Fee invoices, payment recording, financial reports. No academic data access.</field>
    </record>

    <!-- ── 7. Exam Officer ─────────────────────────────────────────────────── -->
    <!-- Owns the assessment workflow: review, approve, lock, publish, and      -->
    <!-- the audited unlock of mark lists (SRS §9, BR-11).                     -->
    <record id="group_school_exam_officer" model="res.groups">
        <field name="name">Exam Officer</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="comment">Create assessments, review and approve mark lists, lock and publish results, authorized unlocks.</field>
    </record>

    <!-- ── 6. Front Office / Communication Officer ─────────────────────────── -->
    <!-- Telegram community broadcasts, parent inquiry logging, issue routing.  -->
    <!-- No editing rights on grades, attendance, or fee records.              -->
    <record id="group_school_frontoffice" model="res.groups">
        <field name="name">Front Office / Communication</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="comment">Telegram broadcasts, parent inquiries, routing. No grade/fee editing.</field>
    </record>

    <!-- ── 1. System Administrator (defined last — implies all peers) ──────── -->
    <record id="group_school_admin" model="res.groups">
        <field name="name">School Administrator</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="implied_ids" eval="[
            (4, ref('group_school_director')),
            (4, ref('group_school_registrar')),
            (4, ref('group_school_teacher')),
            (4, ref('group_school_finance')),
            (4, ref('group_school_frontoffice')),
            (4, ref('group_school_exam_officer')),
        ]"/>
        <field name="comment">Full access: user management, Telegram bot config, system backups, all records.</field>
    </record>
    <!-- Assessment rules added by naz -->
<!-- ── Record Rules ─────────────────────────────────────────────────────── -->
    <!-- Teachers see/edit only assessments and marks for their own active      -->
    <!-- class+subject assignments (SRS §3.2, AC-12). No rule needed for        -->
    <!-- admin/registrar/exam_officer/director — a group with zero rules on a  -->
    <!-- model gets unrestricted access by default.                            -->
    <record id="rule_school_assessment_teacher" model="ir.rule">
        <field name="name">Teacher: own subject/class assessments only</field>
        <field name="model_id" ref="model_school_assessment"/>
        <field name="domain_force">user._school_teacher_pair_domain()</field>
        <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
    </record>

    <record id="rule_school_mark_teacher" model="ir.rule">
        <field name="name">Teacher: own subject/class marks only</field>
        <field name="model_id" ref="model_school_mark"/>
        <field name="domain_force">user._school_teacher_pair_domain()</field>
        <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
    </record>

    <!-- Odoo's built-in admin user always holds the School Administrator role. -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_school_admin'))]"/>
    </record>

</odoo>
