<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_report_card_reopen_form" model="ir.ui.view">
        <field name="name">school.report.card.reopen.form</field>
        <field name="model">school.report.card.reopen</field>
        <field name="arch" type="xml">
            <form string="Reopen Report Card for Correction">
                <group>
                    <field name="report_card_id" options="{'no_create': True}"/>
                    <field name="reason" placeholder="Why this published report card must be reopened."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reopen" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
