<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_school_student" model="ir.sequence">
            <field name="name">Student Registration Number</field>
            <field name="code">school.student</field>
            <field name="prefix">STU-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_school_student_admission" model="ir.sequence">
            <field name="name">Student Admission Number</field>
            <field name="code">school.student.admission</field>
            <field name="prefix">ADM-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
